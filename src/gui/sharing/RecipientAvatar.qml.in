import QtQuick
@QML_AVATAR_EFFECT_IMPORT@

Item {
    id: root

    property url source

    Rectangle {
        id: maskShape
        objectName: "recipientAvatarMaskShape"

        anchors.fill: parent
        radius: width / 2
        color: "white"
        visible: false
        layer.enabled: true
    }

    Image {
        id: avatarImage
        objectName: "recipientAvatarImage"

        anchors.fill: parent
        source: root.source
        sourceSize: Qt.size(width, height)
        fillMode: Image.PreserveAspectFit
        visible: false
        layer.enabled: true
    }

@QML_AVATAR_EFFECT@
}
